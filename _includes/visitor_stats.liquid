<!-- Visitor Statistics - Google Analytics Data -->
{% if site.visitor_stats_enabled %}
<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/echarts@4.9.0/map/js/world.js"></script>

<script>
// Load GA data from local JSON file (updated by GitHub Actions)
document.addEventListener('DOMContentLoaded', function() {
  loadAnalyticsData();
});

function loadAnalyticsData() {
  fetch('/assets/json/analytics.json')
    .then(response => response.json())
    .then(data => {
      if (data && data.totalVisitors && data.totalVisitors > 0) {
        document.getElementById('ga-visitor-count').textContent = data.totalVisitors.toLocaleString();
        if (data.geoData && data.geoData.length > 0) {
          initWorldMap(data.geoData);
        }
      }
    })
    .catch(err => {
      console.log('Analytics data not available yet:', err);
    });
}

function initWorldMap(geoData) {
  var mapContainer = document.getElementById('ga-world-map');
  if (!mapContainer) {
    var socialSection = document.querySelector('.social');
    if (socialSection) {
      mapContainer = document.createElement('div');
      mapContainer.id = 'ga-world-map';
      mapContainer.style.cssText = 'width: 100%; height: 200px; margin-top: 1rem; border-radius: 8px; overflow: hidden;';
      socialSection.parentNode.insertBefore(mapContainer, socialSection.nextSibling);
    }
  }
  if (!mapContainer || typeof echarts === 'undefined') return;

  var chart = echarts.init(mapContainer);

  var visitData = geoData.map(item => ({
    name: item.country,
    value: item.visitors
  }));

  var option = {
    tooltip: {
      trigger: 'item',
      formatter: function(params) {
        return params.name + ': ' + (params.value || 0) + ' visitors';
      }
    },
    visualMap: {
      min: 0,
      max: Math.max(...visitData.map(d => d.value), 100),
      left: 'left',
      top: 'bottom',
      text: ['High', 'Low'],
      textStyle: { fontSize: 10, color: '#666' },
      inRange: { color: ['#e0f3f8', '#abd9e9', '#74add1', '#4575b4', '#313695'] },
      calculable: true,
      itemWidth: 10,
      itemHeight: 60
    },
    series: [{
      name: 'Visitors',
      type: 'map',
      map: 'world',
      roam: false,
      emphasis: {
        label: { show: true, color: '#333' },
        itemStyle: { areaColor: '#ffd700' }
      },
      itemStyle: { borderColor: '#fff', borderWidth: 0.5 },
      data: visitData
    }]
  };

  chart.setOption(option);
  window.addEventListener('resize', function() { chart.resize(); });
}
</script>
{% endif %}
