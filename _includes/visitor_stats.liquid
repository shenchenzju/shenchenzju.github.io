<!-- Visitor Statistics - Google Analytics Data -->
{% if site.visitor_stats_enabled %}
<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/echarts@4.9.0/map/js/world.js"></script>

<script>
// Load GA data from local JSON file (updated by GitHub Actions)
document.addEventListener('DOMContentLoaded', function() {
  loadAnalyticsData();
});

function loadAnalyticsData() {
  fetch('/assets/json/analytics.json')
    .then(response => response.json())
    .then(data => {
      var count = data.totalPageViews || data.totalVisitors || 0;
      if (count > 0) {
        document.getElementById('ga-visitor-count').textContent = count.toLocaleString();
        if (data.geoData && data.geoData.length > 0) {
          initWorldMap(data.geoData);
        }
      }
    })
    .catch(err => {
      console.log('Analytics data not available yet:', err);
    });
}

function initWorldMap(geoData) {
  // Try mini map first, then fallback to full map
  var mapContainer = document.getElementById('ga-world-map-mini') || document.getElementById('ga-world-map');
  console.log('Map container found:', mapContainer ? mapContainer.id : 'null');
  
  if (!mapContainer) {
    var socialSection = document.querySelector('.social');
    if (socialSection) {
      mapContainer = document.createElement('div');
      mapContainer.id = 'ga-world-map';
      mapContainer.style.cssText = 'width: 100%; height: 200px; margin-top: 1rem; border-radius: 8px; overflow: hidden;';
      socialSection.parentNode.insertBefore(mapContainer, socialSection.nextSibling);
    }
  }
  if (!mapContainer || typeof echarts === 'undefined') {
    console.log('ECharts not loaded or no container');
    return;
  }
  
  var isMini = mapContainer.id === 'ga-world-map-mini';
  console.log('Is mini map:', isMini, 'Geo data:', geoData);

  var chart = echarts.init(mapContainer);

  var visitData = geoData.map(item => ({
    name: item.country,
    value: item.visitors
  }));

  // Add scatter points for small countries/cities
  var scatterData = [];
  geoData.forEach(item => {
    var coords = getCountryCoords(item.country);
    if (coords) {
      scatterData.push({
        name: item.country,
        value: coords.concat(item.visitors)
      });
    }
  });

  var option = {
    tooltip: {
      trigger: 'item',
      formatter: function(params) {
        if (params.seriesType === 'effectScatter') {
          return params.name + ': ' + params.value[2] + ' visitors';
        }
        return params.name + ': ' + (params.value || 0) + ' visitors';
      }
    },
    geo: {
      map: 'world',
      roam: true,
      silent: false,
      itemStyle: {
        areaColor: 'transparent',
        borderColor: 'transparent'
      },
      emphasis: {
        disabled: true
      }
    },
    series: [
      {
        name: 'Visitors',
        type: 'map',
        map: 'world',
        roam: true,
        emphasis: {
          label: { show: true, color: '#333' },
          itemStyle: { areaColor: '#ffd700' }
        },
        itemStyle: { 
          borderColor: '#fff', 
          borderWidth: 0.5,
          areaColor: '#e0f3f8'
        },
        data: visitData
      },
      {
        name: 'Cities',
        type: 'effectScatter',
        coordinateSystem: 'geo',
        symbolSize: function(val) {
          return Math.max(10, Math.min(25, val[2] / 1.5));
        },
        showEffectOn: 'render',
        rippleEffect: {
          brushType: 'stroke',
          scale: 3
        },
        itemStyle: {
          color: '#ff6b6b',
          borderColor: '#fff',
          borderWidth: 2,
          shadowBlur: 10,
          shadowColor: 'rgba(255, 107, 107, 0.5)'
        },
        emphasis: {
          scale: 1.5,
          itemStyle: {
            color: '#ffd700'
          }
        },
        data: scatterData
      }
    ]
  };

  chart.setOption(option);
  window.addEventListener('resize', function() { chart.resize(); });
}

// Country/City coordinates for scatter points
function getCountryCoords(country) {
  var coords = {
    'Singapore': [103.8198, 1.3521],
    'Hong Kong': [114.1694, 22.3193],
    'China': [104.1954, 35.8617],
    'United States': [-95.7129, 37.0902],
    'United Kingdom': [-3.4360, 55.3781],
    'Japan': [138.2529, 36.2048],
    'Germany': [10.4515, 51.1657],
    'France': [2.2137, 46.2276],
    'Australia': [133.7751, -25.2744],
    'Canada': [-106.3468, 56.1304],
    'India': [78.9629, 20.5937],
    'South Korea': [127.7669, 35.9078],
    'Netherlands': [5.2913, 52.1326],
    'Switzerland': [8.2275, 46.8182],
    'Sweden': [18.6435, 60.1282],
    'Italy': [12.5674, 41.8719],
    'Spain': [-3.7492, 40.4637],
    'Brazil': [-51.9253, -14.2350],
    'Russia': [105.3188, 61.5240]
  };
  return coords[country] || null;
}
</script>
{% endif %}
